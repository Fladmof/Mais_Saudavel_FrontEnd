# Example environment variables for Mais_Saudavel_FrontEnd (Expo)
# Copy to .env or set in your CI and adjust values as needed.

# Backend API base URL
API_URL=http://localhost:3000

# Used by expo config extra.apiUrl (if you use it)
EXPO_API_URL=http://localhost:3000

# Optional: OAuth / Google client IDs
GOOGLE_CLIENT_ID=

# Optional: other feature flags
ENABLE_SENTRY=false
